<controls:FancyWindow xmlns="https://spacestation14.io"
                     xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                     xmlns:ui="clr-namespace:Content.Client.Materials.UI"
                     Title="{Loc 'ore-silo-ui-title'}"
                     MinSize="400 260"
                     SetSize="400 460">
    <BoxContainer Orientation="Vertical"
                  HorizontalExpand="True"
                  VerticalExpand="True"
                  SeparationOverride="12"
                  Margin="12">
        <BoxContainer VerticalExpand="True"
                      HorizontalExpand="True"
                      Orientation="Vertical"
                      SizeFlagsStretchRatio="3"
                      SeparationOverride="6">
            <Label Text="{Loc 'ore-silo-ui-label-clients'}" HorizontalAlignment="Center" StyleClasses="LabelHeading"/>
            <PanelContainer VerticalExpand="True" StyleClasses="Section">
                <ItemList Name="ClientList" SelectMode="Button" VerticalExpand="True"/>
            </PanelContainer>
        </BoxContainer>
        <BoxContainer VerticalExpand="True"
                      HorizontalExpand="True"
                      Orientation="Vertical"
                      SizeFlagsStretchRatio="2"
                      SeparationOverride="6">
            <Label Text="{Loc 'ore-silo-ui-label-mats'}" HorizontalAlignment="Center" StyleClasses="LabelHeading"/>
            <PanelContainer VerticalExpand="True" StyleClasses="Section">
                <BoxContainer
                    Orientation="Vertical"
                    VerticalExpand="True"
                    HorizontalExpand="True">
                    <ui:MaterialStorageControl Name="Materials"/>
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
