<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:ui="clr-namespace:Content.Client.Materials.UI"
    Title="{Loc 'flatpacker-ui-title'}"
    MinSize="550 350">
    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True" Margin="12" SeparationOverride="12">
        <BoxContainer SizeFlagsStretchRatio="2" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="10">
            <BoxContainer Orientation="Vertical" SeparationOverride="6">
                <EntityPrototypeView Name="MachineSprite" Scale="4 4" HorizontalAlignment="Center" VerticalExpand="True" MinSize="128 128"/>
                <RichTextLabel Name="MachineNameLabel" HorizontalAlignment="Center" StyleClasses="LabelHeading"/>
            </BoxContainer>
            <Button Name="PackButton" Text="{Loc 'flatpacker-ui-pack-button'}" MaxWidth="150"/> 
            <BoxContainer Orientation="Vertical" VerticalExpand="True" RectClipContent="True" SeparationOverride="6">
                <Label Name="CostHeaderLabel" Text="{Loc 'flatpacker-ui-cost-label'}" HorizontalAlignment="Left" StyleClasses="LabelHeading"/>
                <PanelContainer VerticalExpand="True"
                                HorizontalExpand="True" StyleClasses="Section">
                    <BoxContainer Orientation="Vertical" VerticalAlignment="Center" SeparationOverride="4">
                        <RichTextLabel Name="CostLabel" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <RichTextLabel Name="InsertLabel" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>
        </BoxContainer>
        <BoxContainer SizeFlagsStretchRatio="3" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="6">
            <Label Text="{Loc 'flatpacker-ui-materials-label'}" HorizontalAlignment="Center" StyleClasses="LabelHeading"/>
            <PanelContainer
                VerticalExpand="True"
                HorizontalExpand="True"
                RectClipContent="True" StyleClasses="Section">
                <ui:MaterialStorageControl Name="MaterialStorageControl"/>
            </PanelContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
